# Copie para .env.local e preencha os valores.

# true  → dados mock (sem backend)
# false → API Node em VITE_API_URL
VITE_USE_MOCK_DATA=true

VITE_API_URL=http://localhost:8080

# Mercado Pago (checkout)
# VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# Supabase (upload no admin)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Admin
# VITE_ADMIN_PASSWORD=

# Assistente na página /ajuda (Google AI Studio)
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# opcional — padrão: gemini-2.0-flash
# VITE_GEMINI_MODEL=gemini-2.0-flash
